# Conexoes aprovadas para o Skadi. Nao inclua segredos neste arquivo.
DATABASE_URL=
MONGODB_URI=
REDIS_URL=

# Provedores usados como referencia tecnica do Assessor.
GEMINI_API_KEY=
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
